# Copy this file to backend/application-local.yml and fill the values you actually use.
# That copy is gitignored. Leave a value blank to keep that channel off.
# This file overrides application.yml when you start the API from the backend folder.

spring:
  data:
    mongodb:
      # Local Docker: mongodb://localhost:27017/myorbit
      # Atlas free tier: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/myorbit?retryWrites=true&w=majority
      uri: mongodb://localhost:27017/myorbit

app:
  jwt-secret: replace-with-a-long-random-string
  # Free OpenAI-compatible API. Examples:
  # Groq:    https://api.groq.com/openai/v1/chat/completions
  # Ollama:  http://localhost:11434/v1/chat/completions   key can be the word ollama
  llm-url:
  llm-key:
  llm-model: llama-3.1-8b-instant
  # Optional phone channel. The API POSTs JSON { "text", "email", "phone" } to this URL.
  sms-webhook-url:
  mail-host: smtp.gmail.com
  mail-port: 587
  mail-username:
  mail-password:
  mail-from:
  mail-start-tls: true
