# Copy this file to server/.env and fill only the services you want.
# Leave a value blank to skip that service. The app still runs.

PORT=8080
MONGODB_URI=mongodb://127.0.0.1:27017/myorbit

# Change this before you share the API. Any long random string is fine.
JWT_SECRET=change-this-to-a-long-random-string

# Optional. Comma-separated site origins when the website is not on the same PC.
# FRONTEND_ORIGIN=http://localhost:5173

# Optional free AI. Groq: https://console.groq.com
# Or Ollama: LLM_URL=http://127.0.0.1:11434/v1/chat/completions  LLM_KEY=ollama  LLM_MODEL=llama3.1
LLM_URL=
LLM_KEY=
LLM_MODEL=llama-3.1-8b-instant

# Optional email. Gmail needs an App Password, not your normal password.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_STARTTLS=true

# Optional phone webhook. The API posts JSON { email, phone, text }.
SMS_WEBHOOK_URL=
